# syntax=docker/dockerfile:1
# Ubuntu 24.04 + stable ROCm multi-architecture wheels for AMD R9700 (gfx1201).
#
# This is the clean migration path. It deliberately does not run patch_vllm.py,
# alias gfx1201 to an Instinct GPU, replace hipcc, or preload tcmalloc. Those
# workarounds belong to the legacy images and must earn their way back through a
# reproduced failure on the resolved stable stack below.

FROM docker.io/ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.12-venv python3.12-dev python3-pip \
      git curl ca-certificates patch pkg-config protobuf-compiler \
      libgoogle-perftools-dev libnuma-dev numactl libdrm-dev \
      libibverbs-dev ibverbs-utils rdma-core rustc cargo build-essential \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN python3.12 -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PIP_NO_CACHE_DIR=1 \
    PYTHONNOUSERSITE=1

RUN python -m pip install --upgrade \
      pip wheel packaging "setuptools<80.0.0" "setuptools-rust>=1.9.0"

# The workflow/build script resolves the newest complete stable combination.
# The resolved values are passed together so each individual image is
# reproducible without turning today's versions into permanent policy.
ARG ROCM_WHL=https://repo.amd.com/rocm/whl-multi-arch/
ARG TORCH_VERSION
ARG ROCM_VERSION
RUN set -eux; \
    test -n "${TORCH_VERSION}"; \
    test -n "${ROCM_VERSION}"; \
    tv_minor=$(( $(echo "${TORCH_VERSION}" | cut -d. -f2) + 15 )); \
    torchvision_version="0.${tv_minor}.0+rocm${ROCM_VERSION}"; \
    python -m pip install \
      --index-url "${ROCM_WHL}" \
      --extra-index-url https://pypi.org/simple \
      "torch==${TORCH_VERSION}+rocm${ROCM_VERSION}" \
      "amd-torch-device-gfx1201==${TORCH_VERSION}+rocm${ROCM_VERSION}" \
      "rocm-sdk-devel==${ROCM_VERSION}" \
      "rocm-sdk-device-gfx1201==${ROCM_VERSION}" \
      "torchvision==${torchvision_version}" \
      "torchaudio==${TORCH_VERSION}+rocm${ROCM_VERSION}"

RUN python -m pip install --upgrade \
      cmake ninja numpy "setuptools-scm>=8" "setuptools<80.0.0" \
      scikit-build-core pybind11 numba scipy einops pyyaml

# AMD SMI is shipped in the SDK tree but is not installed as a Python package.
# Install the real package; this image does not mock vLLM's platform detection.
RUN root="$(rocm-sdk path --root)" && python -m pip install "${root}/share/amd_smi"

# Build the ROCm flash-attention/AITER pair from exact revisions. AITER lists
# gfx1201 as experimental: its broad operator switch remains off at runtime and
# individual attention backends are selected explicitly by the launcher.
ARG FLASH_ATTN_REF=3f94643fb41bcedded28c85185a8e11d42ef1592
ARG AITER_REF=31350226161346314b3d8882c8085bd31dce6a34
COPY scripts/patch_flash_attn_setup.py /opt/patch_flash_attn_setup.py
RUN set -eux; \
    root="$(rocm-sdk path --root)"; \
    export ROCM_PATH="${root}" HIP_PATH="${root}" \
      PATH="${root}/bin:${root}/lib/llvm/bin:${PATH}" \
      CC="${root}/lib/llvm/bin/amdclang" \
      CXX="${root}/lib/llvm/bin/amdclang++" \
      HIP_DEVICE_LIB_PATH="${root}/lib/llvm/amdgcn/bitcode" \
      CMAKE_PREFIX_PATH="${root}/lib/cmake:${root}" \
      LD_LIBRARY_PATH="${root}/lib:${root}/lib/llvm/lib" \
      PYTORCH_ROCM_ARCH=gfx1201 GPU_ARCHS=gfx1201 AMDGPU_TARGETS=gfx1201 \
      AITER_USE_SYSTEM_TRITON=1; \
    git clone https://github.com/ROCm/flash-attention.git /opt/flash-attention; \
    cd /opt/flash-attention; \
    git checkout --detach "${FLASH_ATTN_REF}"; \
    git submodule update --init third_party/aiter; \
    cd third_party/aiter; \
    git fetch --tags origin; \
    git checkout --detach "${AITER_REF}"; \
    git submodule update --init --recursive; \
    python -m pip wheel --no-build-isolation --no-deps -w /tmp/aiter-dist -v .; \
    python -m pip install --force-reinstall --no-deps /tmp/aiter-dist/amd_aiter*.whl; \
    cd /opt/flash-attention; \
    python /opt/patch_flash_attn_setup.py; \
    python -m pip install --no-build-isolation --no-deps .; \
    rm -rf /opt/flash-attention /tmp/aiter-dist

# The resolver selects the newest non-prerelease upstream tag unless the caller
# explicitly requests another ref. Do not give the Dockerfile a stale default.
ARG VLLM_REF
ARG MAX_JOBS=4
ENV MAX_JOBS=${MAX_JOBS} \
    PYTORCH_ROCM_ARCH=gfx1201 \
    GPU_ARCHS=gfx1201 \
    AMDGPU_TARGETS=gfx1201 \
    VLLM_TARGET_DEVICE=rocm \
    HIP_FORCE_DEV_KERNARG=1 \
    MIOPEN_FIND_MODE=FAST

RUN test -n "${VLLM_REF}" && \
    git clone https://github.com/vllm-project/vllm.git /opt/vllm && \
    cd /opt/vllm && git checkout --detach "${VLLM_REF}"

WORKDIR /opt/vllm
# Match the build path that completed in the reference Ubuntu workflow. Any
# optional Rust components follow vLLM's own setuptools behavior rather than a
# toolbox-specific prebuild step.
ARG VLLM_BUILD_JOBS=4
RUN set -eux; \
    root="$(rocm-sdk path --root)"; \
    export ROCM_PATH="${root}" HIP_PATH="${root}" \
      MAX_JOBS="${VLLM_BUILD_JOBS}" \
      PATH="${root}/bin:${root}/lib/llvm/bin:${PATH}" \
      CC="${root}/lib/llvm/bin/amdclang" \
      CXX="${root}/lib/llvm/bin/amdclang++" \
      HIP_DEVICE_LIB_PATH="${root}/lib/llvm/amdgcn/bitcode" \
      CMAKE_PREFIX_PATH="${root}/lib/cmake:${root}" \
      LD_LIBRARY_PATH="${root}/lib:${root}/lib/llvm/lib" \
      CMAKE_ARGS="-DROCM_PATH=${root} -DHIP_PATH=${root} -DAMDGPU_TARGETS=gfx1201 -DHIP_ARCHITECTURES=gfx1201"; \
    python -m pip wheel --no-build-isolation --no-deps -w /tmp/vllm-dist -v .; \
    python -m pip freeze \
      | grep -E '^(amd-torch-device-gfx1201|torch|torchaudio|torchvision|triton)==' \
      > /tmp/rocm-stack.constraints; \
    torch_before="$(python -c 'import torch; print(torch.__version__)')"; \
    triton_before="$(python -c 'import triton; print(triton.__version__)')"; \
    python -m pip install -c /tmp/rocm-stack.constraints -r requirements/rocm.txt; \
    python -m pip install --no-deps /tmp/vllm-dist/*.whl; \
    test "$(python -c 'import torch; print(torch.__version__)')" = "${torch_before}"; \
    test "$(python -c 'import triton; print(triton.__version__)')" = "${triton_before}"; \
    python -m pip install ray; \
    printf '%s\n' \
      "ROCM_VERSION=${ROCM_VERSION}" \
      "TORCH_VERSION=${TORCH_VERSION}" \
      "VLLM_REF=${VLLM_REF}" \
      "VLLM_COMMIT=$(git rev-parse HEAD)" \
      "AITER_REF=${AITER_REF}" \
      "FLASH_ATTN_REF=${FLASH_ATTN_REF}" \
      > /opt/toolbox-versions.txt; \
    rm -rf /tmp/vllm-dist /tmp/rocm-stack.constraints /root/.cache/pip

# amdsmi dlopen()s this unversioned name when vLLM probes the ROCm platform.
RUN core=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core && \
    ln -sf libamd_smi.so.26 "${core}/lib/libamd_smi.so" && \
    rm -rf /opt/vllm


FROM docker.io/ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
LABEL com.github.containers.toolbox="true" \
      usage="This image is meant to be used with the toolbox command" \
      summary="Ubuntu stable-ROCm vLLM toolbox for AMD R9700 (gfx1201)"

# gcc/g++/make and the Python headers are retained because Triton and AITER JIT
# compile model-specific kernels on the target R9700.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.12 python3.12-dev gcc g++ make git ca-certificates curl sudo \
      libcap2-bin libnss-myhostname libatomic1 libnuma1 libgomp1 libelf1 \
      libdrm2 libdrm-amdgpu1 libtinfo6 zlib1g libssl3 libgoogle-perftools4 \
      libibverbs1 librdmacm1 dialog openssh-client iproute2 procps numactl \
      ibverbs-utils rdma-core perftest infiniband-diags iputils-ping iperf3 \
      pciutils rsync jq vim nano \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Toolbx creates the host user inside the container. Ubuntu's stock UID 1000
# must therefore be removed and kept free. The cache directories are shared by
# dynamically created Toolbx/Distrobox users.
RUN (userdel -r ubuntu 2>/dev/null || true) \
 && if getent passwd 1000 >/dev/null; then \
      echo "ERROR: UID 1000 must be free for Toolbx user creation" >&2; \
      getent passwd 1000 >&2; exit 1; \
    fi \
 && install -d -m 1777 /opt/triton_cache /opt/aiter_jit \
 && rm -f /etc/machine-id && touch /etc/machine-id \
 && sed -Ei 's/^hosts:.*/hosts:          files myhostname dns/' /etc/nsswitch.conf \
 && printf '%s\n' '%sudo ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/toolbox \
 && chmod 0440 /etc/sudoers.d/toolbox \
 && visudo -cf /etc/sudoers.d/toolbox \
 && useradd --uid 1000 --groups sudo --no-create-home toolbox-build-test \
 && su -s /bin/sh toolbox-build-test -c 'touch /opt/triton_cache/.write-test /opt/aiter_jit/.write-test' \
 && su -s /bin/sh toolbox-build-test -c 'sudo -n true' \
 && rm /opt/triton_cache/.write-test /opt/aiter_jit/.write-test \
 && userdel toolbox-build-test \
 && groupadd -f -g 105 render \
 && ln -sf libdrm_amdgpu.so.1 /usr/lib/x86_64-linux-gnu/libdrm_amdgpu.so

COPY --from=builder /opt/venv /opt/venv
# AITER 0.1.19 declares this exact runtime dependency. It is not present on
# repo.amd.com, so install its dependency-free PyPI wheel without allowing pip
# to replace the AMD-provided Torch/Triton stack.
RUN /opt/venv/bin/python -m pip install --no-deps "flydsl==0.2.4"
COPY --from=builder /opt/toolbox-versions.txt /opt/toolbox-versions.txt

COPY scripts/01-rocm-envs-repoamd.sh /etc/profile.d/01-rocm-envs.sh
COPY scripts/99-toolbox-banner.sh /etc/profile.d/99-toolbox-banner.sh
COPY scripts/zz-venv-last.sh /etc/profile.d/zz-venv-last.sh
COPY scripts/start_vllm.py /opt/start-vllm
COPY benchmarks/max_context_results.json /opt/max_context_results.json
COPY benchmarks/run_vllm_bench.py /opt/run_vllm_bench.py
COPY benchmarks/models.py /opt/models.py

RUN chmod 0644 /etc/profile.d/*.sh /opt/max_context_results.json /opt/models.py /opt/toolbox-versions.txt \
 && chmod +x /opt/start-vllm /opt/run_vllm_bench.py \
 && ln -s /opt/start-vllm /usr/local/bin/start-vllm \
 && ln -s /opt/run_vllm_bench.py /usr/local/bin/run-vllm-bench \
 && printf 'ulimit -S -c 0\n' > /etc/profile.d/90-nocoredump.sh \
 && chmod 0644 /etc/profile.d/90-nocoredump.sh

ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYTHONNOUSERSITE=1 \
    TOOLBOX_ROCM_SOURCE="repo.amd.com stable multi-arch wheels" \
    ROCM_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core \
    HIP_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core \
    ROCM_DEVEL_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_devel \
    HIP_DEVICE_LIB_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core/lib/llvm/amdgcn/bitcode \
    CPLUS_INCLUDE_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_devel/include \
    LIBRARY_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_devel/lib \
    LD_LIBRARY_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core/lib:/opt/venv/lib/python3.12/site-packages/_rocm_sdk_libraries/lib \
    PYTORCH_ROCM_ARCH=gfx1201 \
    GPU_ARCHS=gfx1201 \
    FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE \
    VLLM_TARGET_DEVICE=rocm \
    VLLM_ROCM_USE_AITER=0 \
    VLLM_ROCM_USE_AITER_LINEAR=0 \
    HIP_FORCE_DEV_KERNARG=1 \
    MIOPEN_FIND_MODE=FAST \
    TRITON_CACHE_DIR=/opt/triton_cache \
    AITER_JIT_DIR=/opt/aiter_jit

# hipcc's link path requires the normal unversioned development symlink.
RUN if [ ! -e "$ROCM_PATH/lib/libamdhip64.so" ] && [ ! -L "$ROCM_PATH/lib/libamdhip64.so" ]; then \
      ln -s libamdhip64.so.7 "$ROCM_PATH/lib/libamdhip64.so"; \
    fi \
 && test -e "$ROCM_PATH/lib/libamdhip64.so"

# GPU-less image-contract checks. Runtime GPU and backend checks are intentionally
# left for the R9700 validation matrix documented in README.md.
RUN for command_name in start-vllm run-vllm-bench vllm ray dialog rocm-smi hipcc hipconfig g++ make; do \
      command -v "$command_name" >/dev/null || { echo "ERROR: missing runtime command: $command_name" >&2; exit 1; }; \
    done \
 && test -x "$ROCM_PATH/lib/llvm/bin/amdgpu-arch" \
 && test -d "$HIP_DEVICE_LIB_PATH" \
 && test -f "$ROCM_DEVEL_PATH/include/thrust/complex.h" \
 && grep -q 'gfx1201' /opt/venv/lib/python3.12/site-packages/vllm/platforms/rocm.py \
 && python -c "import importlib.util; assert importlib.util.find_spec('aiter'); assert importlib.util.find_spec('flash_attn'); assert importlib.util.find_spec('vllm')" \
 && printf '#include <hip/hip_runtime.h>\nextern "C" __global__ void hip_link_smoke() {}\n' \
      | hipcc --offload-arch=gfx1201 -fPIC -shared -x hip - -o /tmp/hipcc-smoke.so \
 && test -s /tmp/hipcc-smoke.so \
 && python -m py_compile /opt/start-vllm /opt/models.py /opt/run_vllm_bench.py \
 && rm -f /tmp/hipcc-smoke.so \
 && rm -rf /opt/__pycache__

WORKDIR /opt
CMD ["/bin/bash"]
